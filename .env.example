# ── Sanity CMS ────────────────────────────────────────────────
# Cree un projet gratuit sur https://www.sanity.io/manage
# puis copie ces valeurs dans un fichier .env (non versionne).
# Tant que ces variables sont absentes, le site utilise le
# contenu de repli dans src/content/fallback.ts

VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=production
VITE_SANITY_API_VERSION=2024-10-01
